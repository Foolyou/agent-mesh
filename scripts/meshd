#!/usr/bin/env bash
# meshd — manage the agent-mesh backend service for a base directory.
# Each base dir is one independent service: data + registry + logs live in <base>/.agent-mesh.
#
#   meshd start   [--cold]      background-start the backend (idempotent)
#   meshd stop    [--cold]      stop the backend (hot: leave mesh daemons; --cold: reap them)
#   meshd restart [--cold]      stop + start (cold reaps the mesh daemons too)
#   meshd status                backend up/down + port + running meshes
#   meshd logs    [-f]          show / follow the backend log
#
# Scope:  --root <base> (or MESH_WORK_ROOT, default ~)   --port N (or MESH_WORK_PORT, default 10010)
#         --launch <cmd> (or MESH_LAUNCH_CMD, default ./dist/mesh)
set -euo pipefail

INVOKE_PWD="$PWD"
REPO="$(cd "$(dirname "$0")/.." && pwd -P)"

CMD="${1:-}"; shift || true
COLD=0; FOLLOW=0
while (($#)); do
  case "$1" in
    --cold) COLD=1 ;;
    -f|--follow) FOLLOW=1 ;;
    --root) shift; MESH_WORK_ROOT="${1:?--root needs a value}" ;;
    --port) shift; MESH_WORK_PORT="${1:?--port needs a value}" ;;
    --launch) shift; MESH_LAUNCH_CMD="${1:?--launch needs a value}" ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

BASE_RAW="${MESH_WORK_ROOT:-$HOME}"
PORT="${MESH_WORK_PORT:-10010}"
BIN="${MESH_LAUNCH_CMD:-./dist/mesh}"           # how to LAUNCH the backend (start/restart)
# how to run CLI subcommands (ps/kill) — the real binary, independent of the launch command
if [ -x ./dist/mesh ]; then CLI="./dist/mesh"; else CLI="bun run src/main.ts"; fi

# expand the base (relative resolves against where meshd was invoked, not the repo)
case "$BASE_RAW" in
  "~") BASE="$HOME" ;;
  "~/"*) BASE="$HOME/${BASE_RAW#"~/"}" ;;
  /*) BASE="$BASE_RAW" ;;
  *) BASE="$INVOKE_PWD/$BASE_RAW" ;;
esac
ROOT="$BASE/.agent-mesh"
LOG="$ROOT/backend.log"

cd "$REPO" # so ./dist/mesh + scripts/restart-work.sh resolve

healthy() { curl -fsS --connect-timeout 2 --max-time 3 "http://127.0.0.1:$PORT/api/state" >/dev/null 2>&1; }
backend_pid() {
  ss -ltnp 2>/dev/null | awk -v p=":$PORT" '$4 ~ p"$" {print}' | sed -nE 's/.*pid=([0-9]+).*/\1/p' | head -1
}
# run a CLI subcommand (ps/kill) with the host-control env stripped so it can't misfire
mesh_bin() { env -u MESH_SOCK -u MESH_CONFIG -u MESH_HOST_SCRIPT -u MESH_LEASE_MS $CLI "$@"; }

case "$CMD" in
  start)
    if healthy; then echo "already running → http://localhost:$PORT  (root $ROOT)"; exit 0; fi
    if ((COLD)); then MESH_WORK_ROOT="$BASE" MESH_WORK_PORT="$PORT" MESH_LAUNCH_CMD="$BIN" bash scripts/restart-work.sh --cold
    else MESH_WORK_ROOT="$BASE" MESH_WORK_PORT="$PORT" MESH_LAUNCH_CMD="$BIN" bash scripts/restart-work.sh; fi
    ;;
  restart)
    if ((COLD)); then MESH_WORK_ROOT="$BASE" MESH_WORK_PORT="$PORT" MESH_LAUNCH_CMD="$BIN" bash scripts/restart-work.sh --cold
    else MESH_WORK_ROOT="$BASE" MESH_WORK_PORT="$PORT" MESH_LAUNCH_CMD="$BIN" bash scripts/restart-work.sh; fi
    ;;
  stop)
    pid="$(backend_pid || true)"
    if [ -n "$pid" ]; then
      echo "stopping backend pid $pid (SIGTERM)"
      kill -TERM "$pid" 2>/dev/null || true
    else
      echo "backend on $PORT not running"
    fi
    if ((COLD)); then
      echo "reaping mesh daemons under $ROOT…"
      mesh_bin kill --all --root "$BASE" || true
    fi
    ;;
  status)
    echo "service : $ROOT"
    echo "port    : $PORT"
    pid="$(backend_pid || true)"
    if healthy; then echo "backend : UP (pid ${pid:-?})"
    elif [ -n "$pid" ]; then echo "backend : starting/unhealthy (pid $pid)"
    else echo "backend : DOWN"; fi
    echo "meshes  :"
    out="$(mesh_bin ps --root "$BASE" 2>/dev/null || true)"
    if [ -n "$out" ] && [ "$out" != "no running meshes" ]; then printf '%s\n' "$out" | sed 's/^/  /'
    else echo "  (none running)"; fi
    ;;
  logs)
    [ -f "$LOG" ] || { echo "no log at $LOG (start the service first)"; exit 0; }
    if ((FOLLOW)); then tail -f "$LOG"; else tail -n 40 "$LOG"; fi
    ;;
  ""|-h|--help)
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "unknown command: $CMD" >&2
    echo "try: meshd start|stop|restart [--cold] | status | logs [-f]" >&2
    exit 2
    ;;
esac
